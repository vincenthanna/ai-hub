# systemd --user unit. Install with scripts/install-service.sh.
# Linger must be enabled for the account (loginctl show-user "$USER" | grep Linger)
# or the service dies when the last session ends.
[Unit]
Description=ai-hub cross-session message hub
# network-online.target does not exist in the user manager, so this ordering is
# a no-op there; the server binds 0.0.0.0 and does not need the network to be up
# before it starts. It is kept for the case where the unit is copied to a system
# manager instead.
After=network-online.target
# Never stop retrying. The default is to give up after 5 starts in 10 seconds
# and leave the unit failed until someone intervenes, which is exactly the state
# you do not want to discover after an unattended reboot.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/workspace/ai-hub
Environment=AIHUB_HOME=%h/.local/share/ai-hub
Environment=AIHUB_CONFIG=%h/.config/ai-hub/server.json
# /snap/bin must stay on PATH: on ds30 uv lives there.
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
ExecStart=__UV__ run --frozen python -m aihub
Restart=always
RestartSec=5
# Long-poll clients each hold a connection; the default 1024 runs out early.
LimitNOFILE=8192
KillSignal=SIGTERM
TimeoutStopSec=30
# `uv run` reports its child's SIGTERM death as exit 143, so a clean stop would
# otherwise leave the unit in 'failed' and make every status check look alarming.
SuccessExitStatus=143 SIGTERM

[Install]
WantedBy=default.target

  ],
  "tag_rules": [
    {"match": ["traceback (most recent call last)"], "tag": "python-error"},
    {"match": ["segmentation fault", "segfault"], "tag": "crash"},
    {"match": ["timeout", "타임아웃"], "tag": "timeout"},
    {"match": ["permission denied", "권한 거부"], "tag": "permissions"},
